# Postgres connection string (Railway/Render/Neon all give you one of these)
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=true

# Get your key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-5

# Long random string — used to sign admin login tokens
JWT_SECRET=change-me-to-something-long-and-random

# Cron schedule for the daily pipeline run (default: 8am IST)
PIPELINE_CRON=0 8 * * *

PORT=4000
